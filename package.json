{
  "name": "wyt420-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/run-with-auto-log.ts --title \"本地开发启动失败\" -- astro dev",
    "dev:raw": "astro dev",
    "build": "tsx scripts/run-with-auto-log.ts --title \"生产构建失败\" -- astro build && pagefind --site dist",
    "build:raw": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "tsx scripts/run-with-auto-log.ts --title \"代码检查失败\" -- astro check && tsc --noEmit && eslint .",
    "check:raw": "astro check && tsc --noEmit && eslint .",
    "lint": "tsx scripts/run-with-auto-log.ts --title \"Lint 检查失败\" -- eslint .",
    "lint:raw": "eslint .",
    "format": "prettier --write .",
    "add-log": "tsx scripts/add-build-log.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/tailwind": "^6.0.2",
    "@astrojs/vue": "^6.0.1",
    "@vite-pwa/astro": "^1.2.0",
    "@vueuse/core": "^14.3.0",
    "astro": "^6.3.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "jspdf": "^4.2.1",
    "lodash-es": "^4.18.1",
    "mermaid": "^11.15.0",
    "pagefind": "^1.5.2",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-math": "^6.0.0",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.19",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-vue": "^10.9.1",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vue-eslint-parser": "^10.4.0"
  },
  "packageManager": "pnpm@10.33.0"
}
