---
/**
 * 全站外壳布局：SEO 元信息、首屏防主题闪烁脚本、顶栏导航与主内容插槽。
 * 主题与字号由 ThemeControls（Vue）与 head 内联脚本共同写入 localStorage + DOM。
 */
import { siteConfig } from "@/config/site";
import ThemeControls from "@/components/ThemeControls.vue";
import MobileBottomNav from "@/components/MobileBottomNav.vue";
import GlobalHotkeys from "@/components/GlobalHotkeys.vue";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const seoTitle = title ? `${title} | ${siteConfig.title}` : siteConfig.title;
const seoDescription = description ?? siteConfig.description;
const seoImage = image ?? `${siteConfig.siteUrl}/default-og.png`;

function normalizePath(path: string) {
  if (!path || path === "/") return "/";
  return path.replace(/\/$/, "") || "/";
}

const pathname = normalizePath(Astro.url.pathname);

function navActive(href: string) {
  const h = normalizePath(href);
  if (h === "/") return pathname === "/" || pathname.startsWith("/page/");
  return pathname === h || pathname.startsWith(`${h}/`);
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={seoImage} />
    <meta property="og:url" content={Astro.url.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={seoImage} />
    <script is:inline>
      (() => {
        const mode = localStorage.getItem("theme-mode") ?? "system";
        const root = document.documentElement;
        const setTheme = (value) => {
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          const dark = value === "dark" || (value === "system" && prefersDark);
          root.classList.toggle("dark", dark);
        };
        setTheme(mode);
        const font = localStorage.getItem("font-size") ?? "base";
        root.dataset.fontSize = font;
      })();
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <header class="sticky top-0 z-40 border-b border-stone-300/80 bg-[#f8f5ef]/90 backdrop-blur-xl dark:border-white/10 dark:bg-[#171513]/90">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 px-5 py-4 md:flex-nowrap md:px-8">
        <a
          href="/"
          class="font-serif text-xl font-semibold tracking-wide text-surface-ink transition hover:text-brand dark:text-white"
        >
          {siteConfig.title}
        </a>
        <nav class="order-3 flex w-full flex-wrap justify-center gap-1 text-sm md:order-none md:flex md:w-auto md:justify-start md:gap-5">
          {siteConfig.nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                "border-b px-1 py-1.5 font-medium transition",
                navActive(item.href)
                  ? "border-brand text-brand"
                  : "border-transparent text-surface-ink/68 hover:border-surface-ink/30 hover:text-surface-ink dark:text-white/68 dark:hover:border-white/30 dark:hover:text-white"
              ]}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <ThemeControls client:load />
      </div>
    </header>
    <main class="mx-auto max-w-7xl flex-1 px-5 py-8 pb-24 md:px-8 md:pb-12">
      <slot />
    </main>
    <footer class="border-t border-stone-300 dark:border-white/15">
      <div class="mx-auto flex max-w-7xl flex-col gap-4 px-5 py-8 text-xs text-surface-ink/45 dark:text-white/40 sm:flex-row sm:items-center sm:justify-between md:px-8">
        <p>© {new Date().getFullYear()} 王雨婷 · 真实项目与学习记录</p>
        <div class="flex gap-5"><a href="/tags" class="hover:text-brand">主题</a><a href="/build-log" class="hover:text-brand">建设日志</a><a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="hover:text-brand">GitHub</a></div>
      </div>
    </footer>
    <GlobalHotkeys client:idle />
    <MobileBottomNav client:idle navItems={siteConfig.nav.slice(0, 4)} currentPath={Astro.url.pathname} />
  </body>
</html>
