---
/**
 * 全站外壳布局：SEO 元信息、首屏防主题闪烁脚本、顶栏导航与主内容插槽。
 * 主题与字号由 ThemeControls（Vue）与 head 内联脚本共同写入 localStorage + DOM。
 */
import { siteConfig } from "@/config/site";
import ThemeControls from "@/components/ThemeControls.vue";
import MobileBottomNav from "@/components/MobileBottomNav.vue";
import GlobalHotkeys from "@/components/GlobalHotkeys.vue";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const seoTitle = title ? `${title} | ${siteConfig.title}` : siteConfig.title;
const seoDescription = description ?? siteConfig.description;
const seoImage = image ?? `${siteConfig.siteUrl}/default-og.png`;

function normalizePath(path: string) {
  if (!path || path === "/") return "/";
  return path.replace(/\/$/, "") || "/";
}

const pathname = normalizePath(Astro.url.pathname);

function navActive(href: string) {
  const h = normalizePath(href);
  if (h === "/") return pathname === "/" || pathname.startsWith("/page/");
  return pathname === h || pathname.startsWith(`${h}/`);
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={seoImage} />
    <meta property="og:url" content={Astro.url.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={seoImage} />
    <script is:inline>
      (() => {
        const mode = localStorage.getItem("theme-mode") ?? "system";
        const root = document.documentElement;
        const setTheme = (value) => {
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          const dark = value === "dark" || (value === "system" && prefersDark);
          root.classList.toggle("dark", dark);
        };
        setTheme(mode);
        const font = localStorage.getItem("font-size") ?? "base";
        root.dataset.fontSize = font;
      })();
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <header
      class="sticky top-0 z-40 border-b border-surface-ink/10 bg-white/75 shadow-sm shadow-slate-900/5 backdrop-blur-xl dark:border-white/10 dark:bg-surface-ink/80 dark:shadow-black/20"
    >
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-3 md:flex-nowrap">
        <a
          href="/"
          class="bg-gradient-to-r from-brand to-sky-500 bg-clip-text text-lg font-bold text-transparent transition hover:opacity-90"
        >
          {siteConfig.title}
        </a>
        <nav class="order-3 flex w-full flex-wrap justify-center gap-1 text-sm md:order-none md:flex md:w-auto md:justify-start md:gap-1">
          {siteConfig.nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                "rounded-full px-3 py-1.5 font-medium transition",
                navActive(item.href)
                  ? "bg-brand/12 text-brand shadow-sm dark:bg-brand/20 dark:text-sky-300"
                  : "text-surface-ink/78 hover:bg-surface-ink/[0.06] hover:text-brand dark:text-surface-muted/88 dark:hover:bg-white/[0.06] dark:hover:text-sky-400"
              ]}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <ThemeControls client:load />
      </div>
    </header>
    <main class="mx-auto max-w-6xl flex-1 px-4 py-8 pb-24 md:pb-10">
      <slot />
    </main>
    <GlobalHotkeys client:idle />
    <MobileBottomNav client:idle navItems={siteConfig.nav.slice(0, 4)} currentPath={Astro.url.pathname} />
  </body>
</html>
