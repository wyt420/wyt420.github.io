---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPublishedPosts, toArchiveMap } from "@/lib/content";
import { postPermalink } from "@/lib/url";

const posts = await getPublishedPosts();
const archiveMap = toArchiveMap(posts);
const years = [...archiveMap.keys()].sort((a, b) => Number(b) - Number(a));
---

<BaseLayout title="归档">
  <section class="space-y-6">
    <h1 class="text-2xl font-bold">归档</h1>
    <div class="flex flex-wrap gap-2 text-sm">
      {years.map((year) => (
        <a class="rounded border px-2 py-1" href={`#year-${year}`}>{year}</a>
      ))}
    </div>
    {years.map((year) => (
      <section id={`year-${year}`} class="space-y-3">
        <h2 class="text-xl font-semibold">{year}</h2>
        {[...(archiveMap.get(year)?.keys() ?? [])].sort((a, b) => Number(b) - Number(a)).map((month) => (
          <div>
            <h3 class="mb-2 text-sm font-medium">{month} 月</h3>
            <ul class="space-y-1 text-sm">
              {(archiveMap.get(year)?.get(month) ?? []).map((post) => (
                <li>
                  <a href={postPermalink(post)}>{post.data.title}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    ))}
  </section>
</BaseLayout>
