---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import Sidebar from "@/components/Sidebar.astro";
import { getPublishedPosts, toArchiveMap, toTagMap } from "@/lib/content";

const posts = await getPublishedPosts();
const tags = toTagMap(posts);
const archives = [...toArchiveMap(posts).keys()].sort((a, b) => Number(b) - Number(a));
const pagePosts = posts.slice(0, 10);
const totalPages = Math.max(1, Math.ceil(posts.length / 10));
---

<BaseLayout title="首页">
  <div class="grid gap-6 md:grid-cols-[1fr_300px]">
    <section class="space-y-4">
      {pagePosts.map((post) => <PostCard post={post} />)}
      {totalPages > 1 && (
        <nav class="flex justify-center gap-2 text-sm">
          {Array.from({ length: totalPages }).map((_, idx) => (
            <a class="rounded border px-3 py-1" href={idx === 0 ? "/" : `/page/${idx + 1}/`}>
              {idx + 1}
            </a>
          ))}
        </nav>
      )}
    </section>
    <Sidebar tags={tags} recentPosts={posts} archives={archives} />
  </div>
</BaseLayout>
