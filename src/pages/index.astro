---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import HomeHero from "@/components/HomeHero.astro";
import { projects } from "@/config/projects";
import { getPublishedPosts, toArchiveMap, toTagMap } from "@/lib/content";

const posts = await getPublishedPosts();
const tags = toTagMap(posts);
const archives = [...toArchiveMap(posts).keys()];
const featuredProjects = ["mes-cloud-web", "eam-web", "mes-shell-workbench", "daily-stock-analysis"]
  .map((slug) => projects.find((project) => project.slug === slug))
  .filter(Boolean);
const latestPosts = posts.slice(0, 4);
const homeImage = (image: string) => image.replace(/\.png$/i, "-home.webp");
---

<BaseLayout title="首页">
  <HomeHero postCount={posts.length} tagCount={tags.length} archiveYearCount={archives.length} />

  <section class="mb-20" aria-labelledby="featured-projects-title">
    <div class="mb-8 flex items-end justify-between border-b border-stone-300 pb-4 dark:border-white/15">
      <div>
        <p class="mb-2 text-[10px] font-semibold tracking-[0.24em] text-brand">SELECTED WORK</p>
        <h2 id="featured-projects-title" class="font-serif text-3xl font-medium md:text-4xl">精选项目</h2>
      </div>
      <a href="/projects" class="hidden text-sm text-surface-ink/55 hover:text-brand sm:block">全部项目 ↗</a>
    </div>
    <div class="grid gap-x-6 gap-y-10 md:grid-cols-2">
      {featuredProjects.map((project, index) => project && (
        <article class="group relative">
          <a href={`/projects/${project.slug}/`} class="absolute inset-0 z-10" aria-label={`查看项目：${project.name}`}></a>
          <div class="aspect-[16/9] overflow-hidden bg-stone-200 dark:bg-stone-800">
            <img
              src={homeImage(project.image)}
              alt=""
              width="1400"
              height="788"
              class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.025]"
              loading={index > 1 ? "lazy" : "eager"}
              decoding="async"
            />
          </div>
          <div class="mt-4 grid grid-cols-[auto_1fr] gap-4 border-t border-stone-300 pt-4 dark:border-white/15">
            <span class="font-serif text-sm text-brand">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3 class="font-serif text-xl font-medium transition group-hover:text-brand md:text-2xl">{project.name}</h3>
              <p class="mt-2 line-clamp-2 text-sm leading-6 text-surface-ink/55 dark:text-white/55">{project.description}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="posts" class="scroll-mt-24 border-t border-stone-400 py-12 dark:border-white/20 md:py-16">
    <div class="grid gap-12 lg:grid-cols-[1.6fr_.75fr] lg:gap-16">
      <div>
        <div class="mb-3 flex items-end justify-between">
          <div><p class="mb-2 text-[10px] font-semibold tracking-[0.24em] text-brand">RECENT WRITING</p><h2 class="font-serif text-3xl font-medium md:text-4xl">最近记录</h2></div>
          <a href="/archives" class="text-sm text-surface-ink/50 hover:text-brand">全部文章 ↗</a>
        </div>
        <div>{latestPosts.map((post) => <PostCard post={post} />)}</div>
      </div>
      <aside class="border-stone-300 lg:border-l lg:pl-10 dark:border-white/15">
        <p class="mb-2 text-[10px] font-semibold tracking-[0.24em] text-brand">CURRENT LEARNING</p>
        <h2 class="font-serif text-3xl font-medium">正在学习</h2>
        <p class="mt-6 font-serif text-2xl leading-snug">把 AI 能力接进真实业务流程，而不只是做一个对话框。</p>
        <p class="mt-5 text-sm leading-7 text-surface-ink/58 dark:text-white/55">目前在实践大模型 API、检索增强、Agent 工作流与调用成本控制，并持续整理可复用的工程经验。</p>
        <div class="mt-8 border-t border-stone-300 pt-5 text-sm dark:border-white/15">
          <a href="/tags/AI%20应用/" class="block py-2 hover:text-brand">AI 应用学习记录 →</a>
          <a href="/build-log" class="block py-2 hover:text-brand">网站建设日志 →</a>
          <a href="/tags" class="block py-2 hover:text-brand">文章主题索引 →</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
