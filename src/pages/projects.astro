---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import ProjectsBoard from "@/components/ProjectsBoard.vue";
import { projects } from "@/config/projects";
---

<BaseLayout title="项目作品集">
  <PageHeader
    eyebrow="Projects"
    title="项目"
    description="记录真实参与的企业项目与个人实践，重点呈现我解决过的问题、承担的工作和最终落地的结果。"
  />
  <ProjectsBoard client:load projects={projects} />
</BaseLayout>
