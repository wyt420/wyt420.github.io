---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import ProjectsBoard from "@/components/ProjectsBoard.vue";
import { projects } from "@/config/projects";
---

<BaseLayout title="项目作品集">
  <PageHeader
    eyebrow="Projects"
    title="项目作品集"
    description="按类型与技术栈筛选，并尝试从 GitHub 拉取 Star / Fork（受 API 限流影响）。"
  />
  <ProjectsBoard client:load projects={projects} />
</BaseLayout>
