---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import { getProjectBySlug, projects, type ProjectItem } from "@/config/projects";
import { projectPermalink } from "@/lib/url";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug }
  }));
}

const { slug } = Astro.params;
const project = getProjectBySlug(slug ?? "");
if (!project) throw new Error(`Project not found: ${slug}`);

const kindLabels: Record<ProjectItem["kind"], string> = {
  personal: "个人项目",
  company: "公司项目",
  opensource: "开源项目"
};
---

<BaseLayout title={project.name} description={project.description} image={`${Astro.url.origin}${project.image}`}>
  <PageHeader title={project.name} description={project.description} eyebrow="Project">
    <div slot="actions">
      <a
        href="/projects/"
        class="inline-flex items-center gap-1 rounded-full border border-surface-ink/12 bg-white/70 px-4 py-2 text-sm font-medium text-surface-ink/80 transition hover:border-brand/30 hover:text-brand dark:border-white/10 dark:bg-surface-ink/50 dark:text-surface-muted/85 dark:hover:border-brand/40"
      >
        ← 返回项目列表
      </a>
    </div>
  </PageHeader>

  <article class="grid gap-8 lg:grid-cols-[1fr_280px]">
    <section class="space-y-6">
      <img
        src={project.image}
        alt={project.name}
        class="h-56 w-full rounded-2xl border border-surface-ink/10 object-cover shadow-sm dark:border-white/10 md:h-72"
        loading="eager"
      />

      <div class="rounded-2xl border border-surface-ink/10 bg-white/70 p-6 shadow-sm dark:border-white/10 dark:bg-surface-ink/50">
        <h2 class="text-lg font-semibold text-surface-ink dark:text-surface-muted">项目概述</h2>
        <p class="mt-3 text-sm leading-relaxed text-surface-ink/75 dark:text-surface-muted/85">{project.description}</p>
      </div>

      {project.highlights && project.highlights.length > 0 && (
        <div class="rounded-2xl border border-surface-ink/10 bg-white/70 p-6 shadow-sm dark:border-white/10 dark:bg-surface-ink/50">
          <h2 class="text-lg font-semibold text-surface-ink dark:text-surface-muted">核心工作</h2>
          <ul class="mt-3 space-y-2 text-sm leading-relaxed text-surface-ink/75 dark:text-surface-muted/85">
            {project.highlights.map((item) => (
              <li class="flex gap-2">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand dark:bg-sky-400" aria-hidden="true"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="flex flex-wrap gap-3">
        {project.articlePath && (
          <a
            href={project.articlePath}
            class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-brand to-sky-500 px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-brand/25 transition hover:shadow-lg hover:shadow-brand/35"
          >
            阅读完整技术文章 →
          </a>
        )}
        {project.repo && (
          <a
            href={project.repo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full border border-surface-ink/12 bg-white/70 px-5 py-2.5 text-sm font-medium text-surface-ink/80 transition hover:border-brand/30 hover:text-brand dark:border-white/10 dark:bg-surface-ink/50 dark:text-surface-muted/85"
          >
            GitHub 仓库
          </a>
        )}
        {project.demo && (
          <a
            href={project.demo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full border border-surface-ink/12 bg-white/70 px-5 py-2.5 text-sm font-medium text-surface-ink/80 transition hover:border-brand/30 hover:text-brand dark:border-white/10 dark:bg-surface-ink/50 dark:text-surface-muted/85"
          >
            在线演示
          </a>
        )}
      </div>
    </section>

    <aside class="space-y-4 lg:sticky lg:top-24 lg:h-fit">
      <div class="rounded-2xl border border-surface-ink/10 bg-white/70 p-5 shadow-sm dark:border-white/10 dark:bg-surface-ink/50">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-brand dark:text-sky-400">项目信息</h3>
        <dl class="mt-4 space-y-3 text-sm">
          <div>
            <dt class="text-surface-ink/50 dark:text-surface-muted/55">类型</dt>
            <dd class="mt-1 font-medium text-surface-ink dark:text-surface-muted">{kindLabels[project.kind]}</dd>
          </div>
          <div>
            <dt class="text-surface-ink/50 dark:text-surface-muted/55">技术栈</dt>
            <dd class="mt-2 flex flex-wrap gap-2">
              {project.tech.map((tech) => (
                <span class="rounded bg-slate-100 px-2 py-1 text-xs dark:bg-slate-900">{tech}</span>
              ))}
            </dd>
          </div>
        </dl>
      </div>

      {
        projects.filter((item) => item.slug !== project.slug).length > 0 && (
          <div class="rounded-2xl border border-surface-ink/10 bg-white/70 p-5 shadow-sm dark:border-white/10 dark:bg-surface-ink/50">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-brand dark:text-sky-400">其他项目</h3>
            <ul class="mt-3 space-y-2 text-sm">
              {projects
                .filter((item) => item.slug !== project.slug)
                .slice(0, 4)
                .map((item) => (
                  <li>
                    <a
                      class="font-medium text-surface-ink transition hover:text-brand dark:text-surface-muted dark:hover:text-sky-400"
                      href={projectPermalink(item.slug)}
                    >
                      {item.name}
                    </a>
                  </li>
                ))}
            </ul>
          </div>
        )
      }
    </aside>
  </article>
</BaseLayout>
