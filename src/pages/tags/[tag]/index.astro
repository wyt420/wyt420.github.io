---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import { getPublishedPosts } from "@/lib/content";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const posts = (await getPublishedPosts()).filter((post) => post.data.tags.includes(tag ?? ""));
const firstPage = posts.slice(0, 10);
const pageCount = Math.max(1, Math.ceil(posts.length / 10));
---

<BaseLayout title={`标签: ${tag}`}>
  <section class="space-y-4">
    <h1 class="text-2xl font-bold">#{tag}</h1>
    {firstPage.map((post) => <PostCard post={post} />)}
    {pageCount > 1 && (
      <nav class="flex gap-2">
        {Array.from({ length: pageCount }).map((_, idx) => (
          <a class="rounded border px-3 py-1" href={idx === 0 ? `/tags/${tag}/` : `/tags/${tag}/page/${idx + 1}/`}>
            {idx + 1}
          </a>
        ))}
      </nav>
    )}
  </section>
</BaseLayout>
