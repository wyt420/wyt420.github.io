---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import PageHeader from "@/components/PageHeader.astro";
import { getPublishedPosts } from "@/lib/content";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const map = new Map<string, typeof posts>();
  posts.forEach((post) => {
    post.data.tags.forEach((t) => {
      if (!map.has(t)) map.set(t, []);
      map.get(t)!.push(post);
    });
  });

  const paths: Array<{ params: { tag: string; page: string } }> = [];
  map.forEach((items, tag) => {
    const pageCount = Math.ceil(items.length / 10);
    for (let page = 2; page <= pageCount; page += 1) {
      paths.push({ params: { tag, page: String(page) } });
    }
  });
  return paths;
}

const { tag, page } = Astro.params;
const all = (await getPublishedPosts()).filter((post) => post.data.tags.includes(tag ?? ""));
const current = Number(page ?? "1");
const chunks = all.slice((current - 1) * 10, current * 10);
const pageCount = Math.max(1, Math.ceil(all.length / 10));
---

<BaseLayout title={`标签 ${tag} · 第 ${page} 页`}>
  <PageHeader eyebrow="Tag" title={`#${tag}`} description={`第 ${page} / ${pageCount} 页 · 共 ${all.length} 篇`} />

  <div class="space-y-6">
    {chunks.map((post) => <PostCard post={post} />)}
    <nav class="flex flex-wrap justify-center gap-2 pt-2" aria-label="分页">
      {Array.from({ length: pageCount }).map((_, idx) => {
        const n = idx + 1;
        const active = n === current;
        const href = n === 1 ? `/tags/${tag}/` : `/tags/${tag}/page/${n}/`;
        return (
          <a
            href={href}
            class:list={[
              "min-w-[2.25rem] rounded-full px-3 py-1.5 text-center text-sm font-medium transition",
              active
                ? "bg-gradient-to-r from-brand to-sky-500 text-white shadow-md shadow-brand/25"
                : "border border-surface-ink/12 bg-white/60 text-surface-ink/80 hover:border-brand/30 hover:text-brand dark:border-white/10 dark:bg-surface-ink/40 dark:text-surface-muted/85 dark:hover:border-brand/40"
            ]}
            aria-current={active ? "page" : undefined}
          >
            {n}
          </a>
        );
      })}
    </nav>
  </div>
</BaseLayout>
