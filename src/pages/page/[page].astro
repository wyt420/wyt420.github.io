---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import Sidebar from "@/components/Sidebar.astro";
import { getPublishedPosts, toArchiveMap, toTagMap } from "@/lib/content";
import type { Post } from "@/lib/content";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const pageSize = 10;
  const lastPage = Math.max(1, Math.ceil(posts.length / pageSize));

  return Array.from({ length: lastPage }, (_, index) => {
    const currentPage = index + 1;
    const start = index * pageSize;
    const end = start + pageSize;
    const prevUrl = currentPage > 1 ? `/page/${currentPage - 1}/` : null;
    const nextUrl = currentPage < lastPage ? `/page/${currentPage + 1}/` : null;
    return {
      params: { page: String(currentPage) },
      props: {
        currentPage,
        lastPage,
        pageData: posts.slice(start, end),
        prevUrl,
        nextUrl
      }
    };
  });
}

const { currentPage, lastPage, pageData, prevUrl, nextUrl } = Astro.props as {
  currentPage: number;
  lastPage: number;
  pageData: Post[];
  prevUrl: string | null;
  nextUrl: string | null;
};
const posts = await getPublishedPosts();
const tags = toTagMap(posts);
const archives = [...toArchiveMap(posts).keys()].sort((a, b) => Number(b) - Number(a));
---

<BaseLayout title={`第 ${currentPage} 页`}>
  <div class="grid gap-6 md:grid-cols-[1fr_300px]">
    <section class="space-y-4">
      {pageData.map((post) => <PostCard post={post} />)}
      <nav class="flex items-center justify-between text-sm">
        {prevUrl ? <a class="rounded border px-3 py-1" href={prevUrl}>上一页</a> : <span />}
        <span>第 {currentPage} / {lastPage} 页</span>
        {nextUrl ? <a class="rounded border px-3 py-1" href={nextUrl}>下一页</a> : <span />}
      </nav>
    </section>
    <Sidebar tags={tags} recentPosts={posts} archives={archives} />
  </div>
</BaseLayout>
