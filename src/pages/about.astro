---
/** 关于页：个人简介、工作方向与成长经历。 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import { siteConfig } from "@/config/site";

const focusAreas = [
  {
    index: "01",
    title: "AI 应用工程",
    description: "把模型 API、搜索、Agent 与业务流程连接起来，关注可用性、成本和异常兜底。",
  },
  {
    index: "02",
    title: "智能制造",
    description: "长期参与 MES、EAM、ERP 建设，从现场问题出发理解生产、设备、物资和维修流程。",
  },
  {
    index: "03",
    title: "全栈交付",
    description: "覆盖 Web、API 与移动端，能够完成需求拆解、功能实现、接口联调和部署验证。",
  }
];

const journey = [
  { year: "2020—2024", title: "东北大学 · 信息管理与信息系统", note: "建立信息系统、数据分析与软件开发基础，参加数学建模和统计建模竞赛。" },
  { year: "2023", title: "用友网络 · 实施工程师实习", note: "进入大型制造企业项目现场，参与需求、培训、联调和 SQL 报表支持。" },
  { year: "2024—至今", title: "潍柴雷沃 · 信息化工程师", note: "参与 MES、EAM、ERP 建设与运维，逐步覆盖前端、后端、移动端和项目交付。" },
  { year: "现在", title: "向 AI 应用工程持续延伸", note: "实践 LLM API、Agent、搜索增强与 AI 辅助研发，探索 AI 与制造业场景的结合。" }
];
---

<BaseLayout title="关于">
  <PageHeader
    eyebrow="About"
    title="关于我"
    description="王雨婷 · AI 应用工程 × 制造业数字化。记录真实项目、问题复盘与持续成长。"
  />

  <section class="grid gap-8 border-b border-stone-300 pb-14 dark:border-white/15 md:grid-cols-[220px_1fr] md:gap-14 md:pb-16">
    <div>
      <img src={siteConfig.avatar} alt="王雨婷" width="160" height="160" class="h-32 w-32 border border-stone-300 object-cover dark:border-white/15 md:h-40 md:w-40" loading="lazy" />
      <p class="mt-5 text-[10px] font-semibold tracking-[0.22em] text-brand">WANG YUTING</p>
    </div>
    <div class="max-w-3xl">
      <p class="font-serif text-2xl leading-relaxed text-surface-ink dark:text-white md:text-3xl md:leading-relaxed">
        我是一名制造业信息化工程师，主要参与 MES、EAM 与企业数字化项目，也在持续学习如何把 AI 能力落进真实业务场景。
      </p>
      <p class="mt-6 max-w-2xl text-sm leading-7 text-surface-ink/60 dark:text-white/58">
        工作中，我会从需求沟通、业务梳理开始，完成开发、联调、问题定位和上线验证。这里记录的不是工具清单，而是我实际处理过的问题、做过的项目，以及对这些工作的复盘。
      </p>
      <div class="mt-8 flex flex-wrap gap-x-7 gap-y-3 border-t border-stone-300 pt-5 text-sm dark:border-white/15">
        <a href="/projects" class="border-b border-brand pb-1 text-brand">查看项目</a>
        <a href="/resume" class="border-b border-transparent pb-1 text-surface-ink/60 hover:border-surface-ink/30 hover:text-surface-ink dark:text-white/60 dark:hover:text-white">在线简历</a>
        <a href="mailto:984102889@qq.com" class="border-b border-transparent pb-1 text-surface-ink/60 hover:border-surface-ink/30 hover:text-surface-ink dark:text-white/60 dark:hover:text-white">联系我</a>
      </div>
    </div>
  </section>

  <section class="mt-14 md:mt-16">
    <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-brand">What I Build</p>
        <h2 class="mt-2 font-serif text-3xl font-medium">我正在构建的能力组合</h2>
      </div>
      <p class="max-w-xl text-sm leading-6 text-surface-ink/60 dark:text-surface-muted/65">
        我的优势不是单独掌握某一个框架，而是能够理解企业业务，再选择合适的技术把方案真正落地。
      </p>
    </div>
    <div class="mt-8 grid border-l border-t border-stone-300 dark:border-white/15 md:grid-cols-3">
      {focusAreas.map((area) => (
        <article class="group relative min-h-56 overflow-hidden border-b border-r border-stone-300 p-7 dark:border-white/15">
          <span class="font-serif text-sm text-brand">{area.index}</span>
          <h3 class="relative mt-10 font-serif text-2xl font-medium">{area.title}</h3>
          <p class="relative mt-4 text-sm leading-7 text-surface-ink/60 dark:text-surface-muted/65">{area.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="mt-14 grid gap-8 border-y border-stone-300 py-10 dark:border-white/15 md:grid-cols-[.7fr_1.3fr] md:gap-14 md:py-12">
    <div><p class="text-xs font-bold uppercase tracking-[0.22em] text-brand">Current Focus</p><h2 class="mt-3 font-serif text-3xl font-medium">近期关注</h2></div>
    <div class="grid gap-7 sm:grid-cols-3">
      <div><p class="font-serif text-lg">AI × 企业系统</p><p class="mt-2 text-sm leading-6 text-surface-ink/58 dark:text-white/55">探索如何把大模型能力接入已有 MES / EAM，而不是停留在独立聊天界面。</p></div>
      <div><p class="font-serif text-lg">可靠的工作流</p><p class="mt-2 text-sm leading-6 text-surface-ink/58 dark:text-white/55">关注工具调用、外部搜索、错误降级、费用控制以及结果可追溯。</p></div>
      <div><p class="font-serif text-lg">经验沉淀</p><p class="mt-2 text-sm leading-6 text-surface-ink/58 dark:text-white/55">把日常功能开发和问题定位整理成可检索、可复用的项目资产。</p></div>
    </div>
  </section>

  <section class="mt-12">
    <p class="text-xs font-bold uppercase tracking-[0.22em] text-brand">Journey</p>
    <h2 class="mt-2 font-serif text-3xl font-medium">从信息系统到 AI 应用</h2>
    <ol class="relative mt-7 space-y-0 before:absolute before:bottom-3 before:left-[5px] before:top-3 before:w-px before:bg-brand/25 md:before:left-[128px]">
      {journey.map((item) => (
        <li class="relative grid gap-2 pb-7 pl-8 md:grid-cols-[110px_1fr] md:gap-7 md:pl-0">
          <span class="text-xs font-semibold text-brand">{item.year}</span>
          <div class="relative md:pl-7 before:absolute before:-left-[2px] before:top-1 before:h-3 before:w-3 before:rounded-full before:border-2 before:border-brand before:bg-white dark:before:bg-surface-ink"><h3 class="text-sm font-bold">{item.title}</h3><p class="mt-1 text-sm leading-6 text-surface-ink/60 dark:text-surface-muted/65">{item.note}</p></div>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
