---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BuildLogSearch from "@/components/BuildLogSearch.vue";
import { getBuildLogs } from "@/lib/content";

const logs = await getBuildLogs();
const latestDate = logs[0]?.data.date.toLocaleDateString("zh-CN");
---

<BaseLayout title="博客建设日志">
  <section class="space-y-4">
    <h1 class="text-2xl font-bold">博客建设日志</h1>
    <p class="text-sm text-slate-600 dark:text-slate-300">
      采用 Astro + Vue + Tailwind：兼顾内容性能、交互体验、类型安全和工程化可维护性。
    </p>
    <div class="grid gap-3 md:grid-cols-2">
      <div class="rounded border p-3">累计问题数：{logs.length}</div>
      <div class="rounded border p-3">最近更新时间：{latestDate ?? "-"}</div>
    </div>
    <BuildLogSearch
      client:load
      items={logs.map((item) => ({
        slug: item.id,
        title: item.data.title,
        date: item.data.date.toLocaleDateString("zh-CN"),
        problem: item.data.problem
      }))}
    />

    <div class="space-y-4">
      {logs.map((log) => (
        <details id={log.id} class="rounded-xl border border-slate-200 p-4 dark:border-slate-800" open>
          <summary class="cursor-pointer font-semibold">
            {log.data.title} · {log.data.date.toLocaleDateString("zh-CN")}
          </summary>
          <div class="mt-3 space-y-3 text-sm">
            <p>{log.data.problem}</p>
            <ol class="list-decimal space-y-1 pl-5">
              {log.data.solution.map((step) => (
                <li>{step}</li>
              ))}
            </ol>
            {log.data.links && (
              <div>
                <h4 class="mb-1 font-medium">相关链接</h4>
                <ul class="list-disc pl-5">
                  {log.data.links.map((link) => (
                    <li>
                      <a href={link}>{link}</a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
