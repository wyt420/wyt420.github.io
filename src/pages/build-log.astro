---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import BuildLogSearch from "@/components/BuildLogSearch.vue";
import { getBuildLogs } from "@/lib/content";

const logs = await getBuildLogs();
const latestDate = logs[0]?.data.date.toLocaleDateString("zh-CN");
const keywordSet = new Set<string>();
logs.forEach((log) => (log.data.keywords ?? []).forEach((k) => keywordSet.add(k)));
const keywordCount = keywordSet.size;
---

<BaseLayout title="博客建设日志">
  <PageHeader
    eyebrow="Build log"
    title="博客建设日志"
    description="搭建与排障流水账：问题现象、解决步骤与关键词，便于检索与复盘。"
  />

  <div class="mb-10 grid gap-4 sm:grid-cols-3">
    <div
      class="relative overflow-hidden rounded-2xl border border-surface-ink/10 bg-white/75 p-5 shadow-sm backdrop-blur-md dark:border-white/10 dark:bg-surface-ink/50"
    >
      <div
        class="pointer-events-none absolute -right-8 -top-8 h-24 w-24 rounded-full bg-brand/20 blur-2xl dark:bg-brand/30"
        aria-hidden="true"
      />
      <div class="relative text-3xl font-bold tabular-nums text-brand dark:text-sky-400">{logs.length}</div>
      <div class="relative mt-1 text-xs font-semibold uppercase tracking-wider text-surface-ink/50 dark:text-surface-muted/50">
        累计条目
      </div>
    </div>
    <div
      class="relative overflow-hidden rounded-2xl border border-surface-ink/10 bg-white/75 p-5 shadow-sm backdrop-blur-md dark:border-white/10 dark:bg-surface-ink/50"
    >
      <div
        class="pointer-events-none absolute -right-6 -top-6 h-20 w-20 rounded-full bg-brand-accent/20 blur-2xl dark:bg-brand-accent/25"
        aria-hidden="true"
      />
      <div class="relative text-lg font-semibold tabular-nums text-surface-ink dark:text-surface-muted">{latestDate ?? "—"}</div>
      <div class="relative mt-1 text-xs font-semibold uppercase tracking-wider text-surface-ink/50 dark:text-surface-muted/50">
        最近一条日期
      </div>
    </div>
    <div
      class="relative overflow-hidden rounded-2xl border border-surface-ink/10 bg-white/75 p-5 shadow-sm backdrop-blur-md dark:border-white/10 dark:bg-surface-ink/50"
    >
      <div
        class="pointer-events-none absolute -right-8 -bottom-10 h-28 w-28 rounded-full bg-cyan-500/15 blur-2xl"
        aria-hidden="true"
      />
      <div class="relative text-3xl font-bold tabular-nums text-surface-ink dark:text-surface-muted">{keywordCount}</div>
      <div class="relative mt-1 text-xs font-semibold uppercase tracking-wider text-surface-ink/50 dark:text-surface-muted/50">
        去重关键词数
      </div>
    </div>
  </div>

  <BuildLogSearch
    client:load
    items={logs.map((item) => ({
      slug: item.id,
      title: item.data.title,
      date: item.data.date.toLocaleDateString("zh-CN"),
      problem: item.data.problem,
      keywords: item.data.keywords ?? []
    }))}
  />

  <div class="relative mt-12 space-y-6 md:pl-6">
    <div
      class="absolute bottom-0 left-[11px] top-2 hidden w-px bg-gradient-to-b from-brand/60 via-brand-accent/35 to-transparent md:block"
      aria-hidden="true"
    />
    {
      logs.map((log, idx) => (
        <article class="relative md:pl-8">
          <span
            class="absolute left-0 top-5 hidden h-3 w-3 rounded-full border-2 border-white bg-gradient-to-br from-brand to-sky-500 shadow-md shadow-brand/30 md:block dark:border-slate-900"
            aria-hidden="true"
          />
          <details
            id={log.id}
            class="group overflow-hidden rounded-3xl border border-surface-ink/10 bg-white/70 shadow-sm backdrop-blur-md transition open:border-brand/25 open:shadow-lg open:shadow-brand/10 dark:border-white/10 dark:bg-surface-ink/45 dark:open:border-brand/35"
            open={idx === 0}
          >
            <summary class="flex cursor-pointer list-none flex-col gap-2 p-5 marker:content-none sm:flex-row sm:items-center sm:justify-between sm:gap-4 [&::-webkit-details-marker]:hidden">
              <div class="flex min-w-0 flex-1 flex-wrap items-center gap-2 sm:gap-3">
                <time
                  class="shrink-0 rounded-full bg-gradient-to-r from-brand/12 to-brand-accent/10 px-3 py-1 text-xs font-semibold tabular-nums text-brand dark:from-brand/25 dark:to-brand-accent/15 dark:text-sky-300"
                  datetime={log.data.date.toISOString()}
                >
                  {log.data.date.toLocaleDateString("zh-CN")}
                </time>
                <span class="min-w-0 text-base font-semibold leading-snug text-surface-ink dark:text-surface-muted">{log.data.title}</span>
              </div>
              <span class="flex shrink-0 items-center gap-1 text-xs font-medium text-brand dark:text-sky-400">
                <span class="group-open:hidden">展开</span>
                <span class="hidden group-open:inline">收起</span>
                <span class="transition-transform group-open:rotate-180" aria-hidden="true">▼</span>
              </span>
            </summary>
            <div class="space-y-4 border-t border-surface-ink/10 bg-gradient-to-b from-slate-50/50 to-transparent px-5 pb-5 pt-4 dark:border-white/10 dark:from-slate-950/40 dark:to-transparent">
              <div>
                <h3 class="mb-2 flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-amber-700 dark:text-amber-400/90">
                  <span class="h-1 w-6 rounded-full bg-amber-500/80" />
                  问题
                </h3>
                <p class="whitespace-pre-wrap rounded-2xl border border-amber-500/20 bg-amber-500/[0.06] p-4 text-sm leading-relaxed text-surface-ink/90 dark:border-amber-400/15 dark:bg-amber-400/5 dark:text-surface-muted/90">
                  {log.data.problem}
                </p>
              </div>
              <div>
                <h3 class="mb-2 flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-brand dark:text-sky-400">
                  <span class="h-1 w-6 rounded-full bg-gradient-to-r from-brand to-sky-500" />
                  解决步骤
                </h3>
                <ol class="space-y-2">
                  {log.data.solution.map((step, i) => (
                    <li class="flex gap-3 rounded-2xl border border-surface-ink/8 bg-white/80 p-3 text-sm leading-relaxed text-surface-ink/90 dark:border-white/8 dark:bg-surface-ink/35 dark:text-surface-muted/90">
                      <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-brand to-sky-500 text-xs font-bold text-white shadow-sm">
                        {i + 1}
                      </span>
                      <span class="min-w-0 flex-1 pt-0.5">{step}</span>
                    </li>
                  ))}
                </ol>
              </div>
              {log.data.keywords && log.data.keywords.length > 0 && (
                <div>
                  <h3 class="mb-2 text-xs font-bold uppercase tracking-wider text-surface-ink/50 dark:text-surface-muted/50">关键词</h3>
                  <div class="flex flex-wrap gap-2">
                    {log.data.keywords.map((kw) => (
                      <span class="rounded-full border border-brand/20 bg-brand/5 px-2.5 py-1 text-xs font-medium text-brand dark:border-sky-400/25 dark:bg-sky-400/10 dark:text-sky-300">
                        {kw}
                      </span>
                    ))}
                  </div>
                </div>
              )}
              {log.data.links && log.data.links.length > 0 && (
                <div>
                  <h3 class="mb-2 text-xs font-bold uppercase tracking-wider text-brand dark:text-sky-400">相关链接</h3>
                  <ul class="space-y-1.5">
                    {log.data.links.map((link) => (
                      <li>
                        <a
                          class="inline-flex max-w-full items-center gap-1 break-all text-sm font-medium text-brand underline decoration-brand/30 underline-offset-2 hover:decoration-brand dark:text-sky-400 dark:decoration-sky-400/40"
                          href={link}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {link}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </details>
        </article>
      ))
    }
  </div>
</BaseLayout>
