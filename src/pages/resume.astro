---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import ResumePdfButton from "@/components/ResumePdfButton.vue";
import { resumeData } from "@/config/resume";

const heading = "mb-3 border-b-2 border-slate-900 pb-1.5 text-base font-bold tracking-wide text-slate-950 dark:border-slate-200 dark:text-white";
---

<BaseLayout title="在线简历">
  <div class="resume-screen-only">
    <PageHeader eyebrow="Resume" title="在线简历" description="AI 应用开发 / 企业数字化方向">
      <div slot="actions"><ResumePdfButton client:load /></div>
    </PageHeader>
  </div>

  <article id="resume-content" class="mx-auto max-w-[900px] border border-slate-200 bg-white px-7 py-8 text-slate-800 shadow-sm dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200 md:px-12 md:py-10">
    <header class="border-b border-slate-300 pb-5 dark:border-slate-700">
      <div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-end">
        <div>
          <h1 class="text-3xl font-bold tracking-[0.08em] text-slate-950 dark:text-white">{resumeData.name}</h1>
          <p class="mt-2 text-base font-semibold text-slate-700 dark:text-slate-300">{resumeData.title}</p>
        </div>
        <p class="text-sm text-slate-500">{resumeData.location}｜{resumeData.yearsOfExperience}</p>
      </div>
      <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm text-slate-600 dark:text-slate-400">
        {resumeData.contacts.map((item) => (
          <li><span class="font-medium text-slate-800 dark:text-slate-200">{item.type}：</span>{item.href ? <a href={item.href}>{item.label}</a> : item.label}</li>
        ))}
      </ul>
    </header>

    <div class="mt-7 space-y-7">
      <section>
        <h2 class={heading}>职业概述</h2>
        <p class="text-sm leading-7">{resumeData.intro}</p>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm leading-6 text-slate-700 dark:text-slate-300">
          {resumeData.summaryParagraphs.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section>
        <h2 class={heading}>工作经历</h2>
        <div class="space-y-6">
          {resumeData.workExperience.map((exp) => (
            <div>
              <div class="flex flex-col justify-between gap-1 sm:flex-row sm:items-baseline">
                <h3 class="font-bold text-slate-950 dark:text-white">{exp.company}</h3>
                <time class="text-sm text-slate-500">{exp.period}</time>
              </div>
              <p class="mt-1 text-sm font-semibold">{exp.role}</p>
              <ul class="mt-2 list-disc space-y-1.5 pl-5 text-sm leading-6">{exp.highlights.map((item) => <li>{item}</li>)}</ul>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 class={heading}>项目经历</h2>
        <div class="space-y-5">
          {resumeData.openSource.map((item) => (
            <div>
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="font-bold text-slate-950 dark:text-white">{item.project}</h3>
                {item.link && <a href={item.link} class="text-xs">项目详情</a>}
              </div>
              <p class="mt-1.5 text-sm leading-6">{item.contribution}</p>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 class={heading}>专业技能</h2>
        <dl class="space-y-2 text-sm leading-6">
          {resumeData.skills.map((group) => (
            <div class="grid gap-1 sm:grid-cols-[150px_1fr]">
              <dt class="font-bold text-slate-950 dark:text-white">{group.category}</dt>
              <dd><p>{group.items.map((item) => item.name).join("、")}</p><p class="text-slate-600 dark:text-slate-400">{group.description}</p></dd>
            </div>
          ))}
        </dl>
      </section>

      <section>
        <h2 class={heading}>教育背景</h2>
        {resumeData.education.map((edu) => (
          <div>
            <div class="flex flex-col justify-between gap-1 sm:flex-row sm:items-baseline">
              <p><strong class="text-slate-950 dark:text-white">{edu.school}</strong><span class="ml-3 text-sm">{edu.degree}</span></p>
              <time class="text-sm text-slate-500">{edu.period}</time>
            </div>
            <p class="mt-1 text-sm">GPA：{edu.gpa}｜{edu.ranking}</p>
          </div>
        ))}
      </section>

      <section>
        <h2 class={heading}>实习经历</h2>
        {resumeData.internships.map((exp) => (
          <div>
            <div class="flex flex-col justify-between gap-1 sm:flex-row sm:items-baseline"><p><strong class="text-slate-950 dark:text-white">{exp.company}</strong><span class="ml-3 text-sm font-semibold">{exp.role}</span></p><time class="text-sm text-slate-500">{exp.period}</time></div>
            <ul class="mt-2 list-disc space-y-1 pl-5 text-sm leading-6">{exp.highlights.map((item) => <li>{item}</li>)}</ul>
          </div>
        ))}
      </section>

      <section>
        <h2 class={heading}>竞赛与证书</h2>
        <ul class="space-y-2 text-sm leading-6">
          {resumeData.competitions.map((item) => <li class="flex flex-col justify-between gap-1 sm:flex-row"><span><strong>{item.name}</strong>｜{item.role}</span><span>{item.award}｜{item.period}</span></li>)}
        </ul>
        <p class="mt-3 text-sm"><strong>荣誉：</strong>{resumeData.honors.join("；")}</p>
        <p class="mt-1 text-sm"><strong>证书：</strong>{resumeData.certificates.join("；")}</p>
      </section>
    </div>
  </article>
</BaseLayout>

<style is:global>
  @media print {
    @page {
      size: A4;
      margin: 10mm 12mm;
    }

    html,
    body {
      color-scheme: light;
      background: #fff !important;
      font-size: 12px;
    }

    body::before,
    body > header,
    body > nav,
    .resume-screen-only {
      display: none !important;
    }

    body > main {
      max-width: none !important;
      padding: 0 !important;
    }

    #resume-content {
      max-width: none !important;
      border: 0 !important;
      box-shadow: none !important;
      color: #1e293b !important;
    }

    #resume-content section,
    #resume-content li {
      break-inside: avoid;
    }

    #resume-content a {
      color: inherit !important;
      text-decoration: none !important;
    }
  }
</style>
