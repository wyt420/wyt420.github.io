---
import { siteConfig } from "@/config/site";
import type { Post } from "@/lib/content";
import { postPermalink } from "@/lib/url";

interface Props {
  tags: Array<{ tag: string; count: number }>;
  recentPosts: Post[];
  archives: string[];
  /** 首页右侧玻璃容器内：桌面端去掉自身边框，避免与外层重复 */
  inHomeShell?: boolean;
}
const { tags, recentPosts, archives, inHomeShell = false } = Astro.props;
---

<aside
  class:list={[
    "space-y-6 rounded-xl p-4",
    inHomeShell
      ? "border border-surface-ink/10 dark:border-white/10 md:border-0 md:bg-transparent md:p-0"
      : "border border-surface-ink/10 bg-white/50 shadow-sm backdrop-blur-sm dark:border-white/10 dark:bg-surface-ink/40"
  ]}
>
  <section>
    <img src={siteConfig.avatar} alt="avatar" width="64" height="64" class="rounded-full" loading="lazy" />
    <p class="mt-3 text-sm">{siteConfig.description}</p>
    <div class="mt-2 flex gap-3 text-sm">
      <a href={siteConfig.social.github}>GitHub</a>
      <a href={siteConfig.social.twitter}>Twitter</a>
      <a href={siteConfig.social.linkedin}>LinkedIn</a>
    </div>
  </section>
  <section>
    <h3 class="mb-2 font-semibold">热门标签</h3>
    <div class="flex flex-wrap gap-2">
      {tags.slice(0, 12).map((item) => (
        <a class="rounded bg-slate-100 px-2 py-1 text-xs dark:bg-slate-900" href={`/tags/${item.tag}`}>
          #{item.tag} ({item.count})
        </a>
      ))}
    </div>
  </section>
  <section>
    <h3 class="mb-2 font-semibold">最近文章</h3>
    <ul class="space-y-1 text-sm">
      {recentPosts.slice(0, 6).map((post) => (
        <li><a href={postPermalink(post)}>{post.data.title}</a></li>
      ))}
    </ul>
  </section>
  <section>
    <h3 class="mb-2 font-semibold">归档</h3>
    <details open>
      <summary class="cursor-pointer text-sm">年份</summary>
      <ul class="mt-2 space-y-1 text-sm">
        {archives.map((year) => (
          <li><a href={`/archives#year-${year}`}>{year}</a></li>
        ))}
      </ul>
    </details>
  </section>
</aside>
