---
/**
 * 首页首屏：渐变光晕、网格底纹、数据看板与快捷入口（纯 CSS 动效，无额外依赖）。
 */
import { siteConfig } from "@/config/site";

interface Props {
  postCount: number;
  tagCount: number;
  archiveYearCount: number;
}

const { postCount, tagCount, archiveYearCount } = Astro.props;
---

<section
  class="home-hero relative mb-10 overflow-hidden rounded-3xl border border-slate-200/60 bg-slate-950 px-5 py-10 text-slate-100 shadow-2xl shadow-brand/10 dark:border-white/10 dark:shadow-brand/20 md:px-10 md:py-14"
  aria-labelledby="home-hero-title"
>
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="home-hero-blob home-hero-blob-a absolute -left-24 -top-24 h-72 w-72 rounded-full bg-brand/45 blur-[100px] md:h-96 md:w-96"></div>
    <div class="home-hero-blob home-hero-blob-b absolute -right-16 top-1/3 h-80 w-80 rounded-full bg-brand-accent/40 blur-[110px] md:h-[22rem] md:w-[22rem]"></div>
    <div class="home-hero-blob home-hero-blob-c absolute bottom-0 left-1/2 h-56 w-[140%] max-w-none rounded-full bg-cyan-400/25 blur-[88px] dark:bg-cyan-400/20"></div>
    <div
      class="absolute inset-0 opacity-[0.06] dark:opacity-[0.08]"
      style="background-image: linear-gradient(rgba(255,255,255,0.35) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.35) 1px, transparent 1px); background-size: 40px 40px;"
    >
    </div>
    <div
      class="absolute inset-0 opacity-30 mix-blend-overlay dark:opacity-20"
      style="background: radial-gradient(ellipse 80% 50% at 50% -20%, rgba(255,255,255,0.35), transparent);"
    >
    </div>
  </div>

  <div class="relative z-10 mx-auto flex max-w-5xl flex-col gap-10 lg:flex-row lg:items-end lg:justify-between">
    <div class="max-w-2xl flex-1 text-center lg:text-left">
      <p
        class="mb-3 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-medium tracking-wide text-sky-200/90 backdrop-blur-md"
      >
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
        </span>
        {siteConfig.author} · 技术写作与工程笔记
      </p>
      <h1 id="home-hero-title" class="text-4xl font-bold leading-[1.1] tracking-tight md:text-5xl lg:text-6xl">
        <span
          class="bg-gradient-to-br from-white via-sky-100 to-violet-200 bg-clip-text text-transparent dark:from-white dark:via-sky-200/90 dark:to-violet-300"
        >
          {siteConfig.title}
        </span>
      </h1>
      <p class="mt-4 text-sm leading-relaxed text-slate-300/95 md:text-base md:leading-relaxed">
        {siteConfig.description}
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3 lg:justify-start">
        <a
          href="#posts"
          class="group inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-brand to-sky-500 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-brand/35 transition hover:shadow-xl hover:shadow-brand/45"
        >
          最新文章
          <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
        </a>
        <a
          href="/projects"
          class="rounded-full border border-white/15 bg-white/5 px-4 py-2.5 text-sm font-medium text-white/95 backdrop-blur transition hover:border-white/25 hover:bg-white/10"
        >
          项目作品
        </a>
        <a
          href="/resume"
          class="rounded-full border border-white/15 bg-white/5 px-4 py-2.5 text-sm font-medium text-white/95 backdrop-blur transition hover:border-white/25 hover:bg-white/10"
        >
          在线简历
        </a>
        <a
          href="/build-log"
          class="rounded-full border border-white/15 bg-white/5 px-4 py-2.5 text-sm font-medium text-white/95 backdrop-blur transition hover:border-white/25 hover:bg-white/10"
        >
          建设日志
        </a>
      </div>
    </div>

    <div class="mx-auto grid w-full max-w-md shrink-0 grid-cols-3 gap-3 sm:max-w-lg lg:mx-0 lg:w-80">
      <div
        class="rounded-2xl border border-white/10 bg-gradient-to-b from-white/12 to-white/5 p-4 text-center backdrop-blur-md transition hover:border-brand/40 hover:from-brand/20"
      >
        <div class="text-2xl font-bold tabular-nums text-white md:text-3xl">{postCount}</div>
        <div class="mt-1 text-[10px] font-medium uppercase tracking-wider text-slate-400 md:text-xs">文章</div>
      </div>
      <div
        class="rounded-2xl border border-white/10 bg-gradient-to-b from-white/12 to-white/5 p-4 text-center backdrop-blur-md transition hover:border-violet-400/40 hover:from-brand-accent/25"
      >
        <div class="text-2xl font-bold tabular-nums text-white md:text-3xl">{tagCount}</div>
        <div class="mt-1 text-[10px] font-medium uppercase tracking-wider text-slate-400 md:text-xs">标签</div>
      </div>
      <div
        class="rounded-2xl border border-white/10 bg-gradient-to-b from-white/12 to-white/5 p-4 text-center backdrop-blur-md transition hover:border-cyan-400/40 hover:from-cyan-500/20"
      >
        <div class="text-2xl font-bold tabular-nums text-white md:text-3xl">{archiveYearCount}</div>
        <div class="mt-1 text-[10px] font-medium uppercase tracking-wider text-slate-400 md:text-xs">年份</div>
      </div>
    </div>
  </div>
</section>

<style>
  .home-hero-blob-a {
    animation: homeHeroFloatA 16s ease-in-out infinite;
  }
  .home-hero-blob-b {
    animation: homeHeroFloatB 20s ease-in-out infinite;
  }
  .home-hero-blob-c {
    animation: homeHeroFloatC 18s ease-in-out infinite;
  }
  @keyframes homeHeroFloatA {
    0%,
    100% {
      opacity: 0.55;
      transform: scale(1) translate(0, 0);
    }
    50% {
      opacity: 0.85;
      transform: scale(1.08) translate(12px, 18px);
    }
  }
  @keyframes homeHeroFloatB {
    0%,
    100% {
      opacity: 0.5;
      transform: scale(1) translate(0, 0);
    }
    50% {
      opacity: 0.9;
      transform: scale(1.06) translate(-16px, 12px);
    }
  }
  @keyframes homeHeroFloatC {
    0%,
    100% {
      opacity: 0.45;
      transform: translate(-50%, 33%) scale(1);
    }
    50% {
      opacity: 0.75;
      transform: translate(-50%, 33%) scale(1.05);
    }
  }
</style>
