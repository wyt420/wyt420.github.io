---
import { siteConfig } from "@/config/site";

interface Props {
  postCount: number;
  tagCount: number;
  archiveYearCount: number;
}

const { postCount } = Astro.props;
---

<section class="editorial-hero mb-16 overflow-hidden border-y border-stone-300 bg-[#171513] text-[#f7f3eb] dark:border-stone-700" aria-labelledby="home-hero-title">
  <div class="grid lg:grid-cols-[0.92fr_1.08fr]">
    <div class="relative z-10 flex min-h-[430px] flex-col justify-center px-7 py-12 md:px-12 lg:min-h-[500px] lg:px-14">
      <p class="mb-7 text-xs tracking-[0.24em] text-[#c9bdb0]">MES · EAM · AI 应用</p>
      <h1 id="home-hero-title" class="max-w-xl font-serif text-4xl leading-[1.18] tracking-[-0.035em] md:text-6xl">
        把业务问题，<br />落成可用的系统
      </h1>
      <p class="mt-7 max-w-lg text-sm leading-7 text-[#d4ccc3] md:text-base">{siteConfig.description}</p>
      <div class="mt-9 flex items-center gap-7 text-sm">
        <a href="/projects" class="border-b border-[#9b2f32] pb-1 font-semibold text-white hover:text-[#e0b3aa]">查看项目</a>
        <a href="#posts" class="text-[#c9bdb0] hover:text-white">阅读文章</a>
      </div>
      <p class="mt-12 text-[11px] tracking-[0.16em] text-white/30">{postCount} 篇开发与学习记录</p>
    </div>

    <div class="hero-visual relative min-h-[330px] overflow-hidden lg:min-h-[500px]">
      <img
        src="/project-mes-cloud-web-v2-home.webp"
        alt="制造现场与 MES 工作台"
        width="1400"
        height="788"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover opacity-85"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#171513] via-[#171513]/15 to-transparent"></div>
      <div class="absolute inset-x-0 bottom-0 flex items-end justify-between border-t border-white/15 bg-black/20 px-6 py-5 backdrop-blur-sm md:px-8">
        <div><p class="text-xs tracking-[0.18em] text-white/45">FEATURED / 01</p><p class="mt-2 font-serif text-xl">MES 工作台与应用中心</p></div>
        <a href="/projects/mes-cloud-web/" class="flex h-10 w-10 items-center justify-center rounded-full border border-white/30 text-lg hover:bg-white hover:text-black" aria-label="查看 MES 项目">↗</a>
      </div>
    </div>
  </div>
</section>
