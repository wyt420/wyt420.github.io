---
/** 编辑式文章条目：以标题、日期和内容摘要为主，弱化卡片装饰。 */
import type { Post } from "@/lib/content";
import { postPermalink } from "@/lib/url";
interface Props {
  post: Post;
}
const { post } = Astro.props;
const href = postPermalink(post);
---

<article class="group relative grid gap-3 border-t border-stone-300 py-7 transition dark:border-white/15 md:grid-cols-[9rem_1fr_auto] md:items-start md:gap-6">
  <a href={href} class="absolute inset-0 z-0" aria-label={`阅读文章：${post.data.title}`}></a>
  <div class="pointer-events-none relative z-[1] flex items-center gap-2 text-[11px] tracking-[0.08em] text-surface-ink/45 dark:text-surface-muted/45">
    {post.data.top && (
      <span class="text-brand">置顶</span>
    )}
    <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString("zh-CN")}</time>
  </div>
  <div class="pointer-events-none relative z-[1]">
    <h2 class="font-serif text-xl font-medium leading-snug text-surface-ink transition group-hover:text-brand dark:text-surface-muted md:text-2xl">{post.data.title}</h2>
    {post.data.description && <p class="mt-2 line-clamp-2 max-w-3xl text-sm leading-6 text-surface-ink/58 dark:text-surface-muted/65">{post.data.description}</p>}
    <p class="mt-3 text-[11px] text-surface-ink/40 dark:text-white/35">{post.data.tags.join(" · ")}</p>
  </div>
  <span class="pointer-events-none relative z-[1] text-xl text-brand transition group-hover:translate-x-1">→</span>
</article>
