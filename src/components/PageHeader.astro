---
interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
}

const { title, description, eyebrow } = Astro.props;
---

<header class="mb-12 border-b border-stone-300 pb-9 pt-5 dark:border-white/15 md:mb-16 md:pb-12 md:pt-10">
  <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
    <div class="min-w-0 flex-1">
      {eyebrow && (
        <p class="mb-4 text-[10px] font-semibold uppercase tracking-[0.28em] text-brand">
          {eyebrow}
        </p>
      )}
      <h1 class="font-serif text-4xl font-medium tracking-[-0.035em] text-surface-ink dark:text-white md:text-6xl">{title}</h1>
      {description && (
        <p class="mt-5 max-w-2xl text-sm leading-7 text-surface-ink/62 dark:text-surface-muted/65 md:text-base">{description}</p>
      )}
      <slot />
    </div>
    <div class="shrink-0 md:pb-1">
      <slot name="actions" />
    </div>
  </div>
</header>
