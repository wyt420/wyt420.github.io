PUBLIC_GA_ID=
# 可选：提高 GitHub REST 限流；关于页构建时会拉取 Stars / 公开仓库数；带 Token 时额外拉取近 12 个月提交贡献（GraphQL）
GITHUB_API_TOKEN=
# 可选：单次 GitHub 请求超时（毫秒），关于页；默认 15000
GITHUB_FETCH_TIMEOUT_MS=

# Giscus（https://giscus.app/zh-CN 生成后填入；部署到 GitHub Actions 时可在仓库 Settings → Secrets and variables → Actions → Variables 配置同名变量）
PUBLIC_GISCUS_REPO=wyt420/wyt420.github.io
PUBLIC_GISCUS_REPO_ID=R_kgDOSb3BCw
PUBLIC_GISCUS_CATEGORY=Announcements
PUBLIC_GISCUS_CATEGORY_ID=DIC_kwDOSb3BC84C88Ry
